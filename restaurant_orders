// كود استقبال الطلبات لشاشة الكاشير في الويندوز
const socket = io('https://render-kr1o.onrender.com/', { transports: ['websocket'] });

socket.on('connect', () => {
    console.log("متصل بسيرفر الطلبات بنجاح!");
});

socket.on('otherPlayerMoved', (data) => {
    // التأكد من أن الحدث قادم من غرفة طلبات المطعم وأنه طلب جديد
    if (data.room === 'restaurant_orders' && data.type === 'new_order') {
        console.log("وصل طلب جديد:", data);
        
        // 1. تشغيل صوت تنبيه الكاشير
        const alarm = new Audio('alarm.mp3');
        alarm.play();

        // 2. عرض تفاصيل الطلب على الشاشة
        alert(`طلب جديد من: ${data.customer.name} \nالمجموع: ${data.totalPrice} ل.س`);

        // 3. (اختياري) إرسال إشعار للزبون بأن الطلب قيد التجهيز
        socket.emit('playerMoved', {
            type: 'order_status_update',
            room: 'restaurant_orders',
            orderId: data.orderId,
            status: 'قيد التجهيز في المطبخ 👨‍🍳'
        });
    }
});
